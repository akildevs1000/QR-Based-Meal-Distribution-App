{
  "name": "meal-distribution-app",
  "version": "0.1.0",
  "description": "Meal Distribution App — desktop application for managing meal distributions",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.akilgroup.mealdistributionapp",
    "productName": "Meal Distribution App",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/php",
        "to": "php",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../admin/dist",
        "to": "admin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!.env",
          "!.env.backup",
          "!storage/logs/*.log",
          "!storage/framework/cache/data/**",
          "!storage/framework/sessions/*",
          "!storage/framework/views/*",
          "!database/database.sqlite",
          "!tests/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MealDistributionApp-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Meal Distribution App",
      "include": "build/installer.nsh"
    }
  }
}
